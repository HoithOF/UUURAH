generator client {
  provider = "prisma-client-js"
}

// SQLite locally, Postgres in production: scripts/prisma-provider.mjs sets this from DATABASE_URL at build time.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  createdAt    DateTime     @default(now())
  emailVerifiedAt DateTime?
  // IANA zone, e.g. "America/Chicago". Used for every date shown to this user.
  timeZone     String       @default("America/New_York")
  // Two-step login (TOTP). The secret is AES-GCM encrypted; recovery codes are a JSON array of sha256 hashes.
  totpSecretEnc String?
  totpEnabledAt DateTime?
  recoveryCodes String?
  sessions     Session[]
  memberships  Membership[]
}

// One-time links sent by email: password reset, email verification, team invites.
// Only the sha256 of the token is stored.
model AuthToken {
  id          String    @id @default(cuid())
  kind        String // reset | verify | invite
  tokenHash   String    @unique
  email       String
  userId      String?
  workspaceId String?
  role        String?
  invitedById String?
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([kind, email])
  @@index([workspaceId])
}

// Sliding-window counters for login, signup and email-sending limits.
model RateHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// A company. Every piece of business data belongs to exactly one workspace.
model Workspace {
  id           String             @id @default(cuid())
  name         String
  createdAt    DateTime           @default(now())
  memberships  Membership[]
  connections  Connection[]
  transactions MoneyTransaction[]
  invoices     Invoice[]
  adMetrics    AdMetric[]
  messages     Message[]
  events       CalendarEvent[]
  deals        Deal[]
  payrollRuns  PayrollRun[]
  employees    Employee[]
  oauthStates  OAuthState[]
  accessKeys   AccessKey[]
}

// role: "owner" | "admin" | "member"
model Membership {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  role        String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([userId, workspaceId])
}

// One connected outside account (a Stripe account, a Google login, a file-upload source).
// Tokens are AES-256-GCM encrypted; plaintext tokens never touch the database.
model Connection {
  id                String     @id @default(cuid())
  workspaceId       String
  workspace         Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider          String
  externalAccountId String
  displayName       String
  status            String     @default("connected") // connected | error | disconnected
  accessTokenEnc    String?
  refreshTokenEnc   String?
  tokenExpiresAt    DateTime?
  scopes            String?
  lastSyncedAt      DateTime?
  syncCursor        String? // incremental-sync bookmark for apps that use one (Plaid)
  lastError         String?
  createdAt         DateTime   @default(now())
  syncRuns          SyncRun[]
  transactions      MoneyTransaction[]
  invoices          Invoice[]
  balances          AccountBalance[]
  adMetrics         AdMetric[]
  messages          Message[]
  events            CalendarEvent[]
  deals             Deal[]
  payrollRuns       PayrollRun[]
  employees         Employee[]

  @@unique([workspaceId, provider, externalAccountId])
  @@index([provider, externalAccountId])
}

model SyncRun {
  id           String     @id @default(cuid())
  connectionId String
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  trigger      String // manual | webhook | schedule | upload
  status       String // running | success | error
  itemsSynced  Int        @default(0)
  error        String?
  startedAt    DateTime   @default(now())
  finishedAt   DateTime?
}

// The shared money format: Stripe, Square, QuickBooks and spreadsheets all land here.
// kind: "sale" | "refund" | "fee" | "expense" | "payout"
// amountCents: positive = money in, negative = money out.
model MoneyTransaction {
  id           String      @id @default(cuid())
  workspaceId  String
  workspace    Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectionId String?
  connection   Connection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  source       String
  externalId   String
  kind         String
  amountCents  Int
  currency     String
  occurredAt   DateTime
  description  String?
  category     String?

  @@unique([workspaceId, source, externalId])
  @@index([workspaceId, occurredAt])
}

// Short-lived CSRF state for OAuth sign-in round trips.
model OAuthState {
  state       String    @id
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  provider    String
  createdAt   DateTime  @default(now())
}

// Invoices and bills from accounting apps. direction: "receivable" (customers owe us)
// or "payable" (we owe suppliers). balanceCents = what is still unpaid.
model Invoice {
  id           String      @id @default(cuid())
  workspaceId  String
  workspace    Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectionId String?
  connection   Connection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  source       String
  externalId   String
  direction    String
  number       String?
  contact      String?
  totalCents   Int
  balanceCents Int
  currency     String
  issuedAt     DateTime
  dueAt        DateTime?
  status       String

  @@unique([workspaceId, source, externalId])
  @@index([workspaceId, direction, dueAt])
}

// Latest balance of each bank or card account, for cash on hand and runway.
model AccountBalance {
  id           String     @id @default(cuid())
  connectionId String
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  accountId    String
  name         String
  type         String // depository | credit | loan | investment | other
  currentCents Int
  currency     String
  updatedAt    DateTime   @updatedAt

  @@unique([connectionId, accountId])
}

// One campaign's results on one day, from any ad platform.
model AdMetric {
  id                   String      @id @default(cuid())
  workspaceId          String
  workspace            Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectionId         String?
  connection           Connection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  source               String
  campaignId           String
  campaignName         String
  date                 DateTime
  spendCents           Int
  impressions          Int
  clicks               Int
  conversions          Float
  conversionValueCents Int
  currency             String

  @@unique([workspaceId, source, campaignId, date])
  @@index([workspaceId, date])
}

// Recent email from connected mailboxes (headers and a short preview, not full bodies).
model Message {
  id          String      @id @default(cuid())
  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectionId String
  connection  Connection  @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  source      String
  externalId  String
  threadId    String?
  fromName    String?
  fromEmail   String?
  subject     String?
  preview     String?
  receivedAt  DateTime
  isRead      Boolean     @default(false)
  needsReply  Boolean     @default(false)
  webLink     String?

  @@unique([connectionId, externalId])
  @@index([workspaceId, needsReply, receivedAt])
}

model CalendarEvent {
  id          String     @id @default(cuid())
  workspaceId String
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectionId String
  connection  Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  source      String
  externalId  String
  title       String
  startsAt    DateTime
  endsAt      DateTime
  allDay      Boolean    @default(false)
  location    String?
  organizer   String?
  myResponse  String? // accepted | tentative | declined | needsAction | organizer
  attendees   Int        @default(0)
  webLink     String?

  @@unique([connectionId, externalId])
  @@index([workspaceId, startsAt])
}

model Deal {
  id             String     @id @default(cuid())
  workspaceId    String
  workspace      Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectionId   String
  connection     Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  source         String
  externalId     String
  name           String
  amountCents    Int
  currency       String
  stage          String
  isClosed       Boolean
  isWon          Boolean
  closeDate      DateTime?
  openedAt       DateTime
  lastActivityAt DateTime?
  webLink        String?

  @@unique([connectionId, externalId])
  @@index([workspaceId, isClosed])
}

model PayrollRun {
  id           String     @id @default(cuid())
  workspaceId  String
  workspace    Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectionId String
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  source       String
  externalId   String
  checkDate    DateTime
  grossCents   Int
  netCents     Int
  people       Int
  currency     String

  @@unique([connectionId, externalId])
  @@index([workspaceId, checkDate])
}

model Employee {
  id           String     @id @default(cuid())
  workspaceId  String
  workspace    Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectionId String
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  externalId   String
  name         String
  title        String?
  status       String // active | inactive | pending
  startedAt    DateTime?
  endedAt      DateTime?

  @@unique([connectionId, externalId])
}

// A key that lets an outside AI app (Claude, ChatGPT, etc.) read this workspace through /api/mcp.
// Only the sha256 of the key is stored; the key itself is shown once when created.
model AccessKey {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  name        String
  keyHash     String    @unique
  lastFour    String
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?

  @@index([workspaceId])
}
