# Local development uses SQLite. For production, switch the provider in
# prisma/schema.prisma to "postgresql" and point this at your Postgres/Supabase URL.
DATABASE_URL="file:./dev.db"

# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Encrypts every connected account's tokens at rest. Never change it after launch
# without re-encrypting, or existing connections stop working.
ENCRYPTION_KEY=""

# Public URL of the app, used to build OAuth redirect URLs.
APP_URL="http://localhost:3000"

# Shared secret for the scheduled sync endpoint (/api/cron/sync).
CRON_SECRET=""

# Stripe Connect (Dashboard > Settings > Connect). Leave blank to hide "Connect Stripe".
STRIPE_CLIENT_ID=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Square (developer.squareup.com > your app > OAuth). SQUARE_ENV=sandbox for testing.
SQUARE_APP_ID=""
SQUARE_APP_SECRET=""
SQUARE_ENV="production"

# QuickBooks Online (developer.intuit.com > your app > Keys & credentials).
QUICKBOOKS_CLIENT_ID=""
QUICKBOOKS_CLIENT_SECRET=""
QUICKBOOKS_ENV="production"

# Xero (developer.xero.com > My Apps). XERO_SCOPES only if your app uses the older broad scopes.
XERO_CLIENT_ID=""
XERO_CLIENT_SECRET=""
XERO_SCOPES=""

# Plaid (dashboard.plaid.com > Developers > Keys). PLAID_ENV: sandbox | production
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="sandbox"

# Google (console.cloud.google.com > APIs & Services > Credentials > OAuth client). Shared by
# Google Ads, Analytics, Calendar and Gmail.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Google Ads API developer token (Google Ads > Tools > API Center). Starts as test-only access.
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_API_VERSION="v22"

# Meta (developers.facebook.com > your app). ads_read needs Meta app review for other people's accounts.
META_APP_ID=""
META_APP_SECRET=""
META_API_VERSION="v23.0"

# Microsoft (portal.azure.com > App registrations). Redirect URI: <APP_URL>/api/connect/outlook/callback
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# HubSpot (developers.hubspot.com > your app > Auth). Redirect: <APP_URL>/api/connect/hubspot/callback
HUBSPOT_CLIENT_ID=""
HUBSPOT_CLIENT_SECRET=""

# Merge (app.merge.dev > API keys). Covers Gusto, ADP, Rippling, Paychex and more for payroll.
MERGE_API_KEY=""

# AI assistant (console.anthropic.com > API keys). Only this server uses it; owners never see it.
ANTHROPIC_API_KEY=""

# Email (resend.com > API keys). Used for password resets, invites, email confirmation and alerts.
# Without it, development prints emails to the server log; production refuses to start sending.
RESEND_API_KEY=""
EMAIL_FROM="UUURAH <alerts@yourdomain.com>"

# Public pages (landing page, privacy policy, terms). Set LEGAL_REVIEWED=true after a lawyer reviews them.
SITE_NAME="UUURAH"
COMPANY_LEGAL_NAME=""
CONTACT_EMAIL=""
COMPANY_ADDRESS=""
GOVERNING_LAW=""
LEGAL_REVIEWED="false"
