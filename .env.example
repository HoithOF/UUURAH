# Local development uses SQLite. For production, switch the provider in
# prisma/schema.prisma to "postgresql" and point this at your Postgres/Supabase URL.
DATABASE_URL="file:./dev.db"

# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Encrypts every connected account's tokens at rest. Never change it after launch
# without re-encrypting, or existing connections stop working.
ENCRYPTION_KEY=""

# Public URL of the app, used to build OAuth redirect URLs.
APP_URL="http://localhost:3000"

# Shared secret for the scheduled sync endpoint (/api/cron/sync).
CRON_SECRET=""

# Stripe Connect (Dashboard > Settings > Connect). Leave blank to hide "Connect Stripe".
STRIPE_CLIENT_ID=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
