# Local development uses SQLite. For production, switch the provider in
# prisma/schema.prisma to "postgresql" and point this at your Postgres/Supabase URL.
DATABASE_URL="file:./dev.db"

# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Encrypts every connected account's tokens at rest. Never change it after launch
# without re-encrypting, or existing connections stop working.
ENCRYPTION_KEY=""

# Public URL of the app, used to build OAuth redirect URLs.
APP_URL="http://localhost:3000"

# Shared secret for the scheduled sync endpoint (/api/cron/sync).
CRON_SECRET=""

# Stripe Connect (Dashboard > Settings > Connect). Leave blank to hide "Connect Stripe".
STRIPE_CLIENT_ID=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Square (developer.squareup.com > your app > OAuth). SQUARE_ENV=sandbox for testing.
SQUARE_APP_ID=""
SQUARE_APP_SECRET=""
SQUARE_ENV="production"

# QuickBooks Online (developer.intuit.com > your app > Keys & credentials).
QUICKBOOKS_CLIENT_ID=""
QUICKBOOKS_CLIENT_SECRET=""
QUICKBOOKS_ENV="production"

# Xero (developer.xero.com > My Apps). XERO_SCOPES only if your app uses the older broad scopes.
XERO_CLIENT_ID=""
XERO_CLIENT_SECRET=""
XERO_SCOPES=""

# Plaid (dashboard.plaid.com > Developers > Keys). PLAID_ENV: sandbox | production
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="sandbox"
